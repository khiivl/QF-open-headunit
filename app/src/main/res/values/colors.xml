    <color name="home_extreme_tile_stroke">#161616</color>
    <color name="home_extreme_slot_stroke">#262626</color>
    <color name="home_extreme_text">#B8B8B8</color>
    <color name="home_extreme_text_muted">#7A7A7A</color>
    <color name="home_extreme_apps_tile">#0A0A0A</color>
    <color name="home_extreme_apps_tile_pressed">#161616</color>
    <color name="home_extreme_apps_icon">#4A9A92</color>
    <color name="home_extreme_usb">#B87445</color>
    <color name="home_extreme_wifi">#009688</color>
    <color name="home_extreme_self">#5A87C2</color>
    <color name="home_extreme_monochrome">#7A7A7A</color>
    <color name="home_extreme_countdown_ring">#44B8B8B8</color>
    <!-- The one-time hint on the launcher home that shows where pages are added. -->
    <color name="home_hint_scrim">#BD04060A</color>
    <color name="home_hint_callout">#F3F5F8</color>
    <color name="home_hint_title">#12161C</color>
    <color name="home_hint_body">#39414D</color>
    <color name="home_hint_button">#415F91</color>
    <color name="home_hint_button_focused">#5F7FB5</color>
    <!-- The app's toasts (Toaster): the card of wDSP Pro's Classic look. Night ones in values-night. -->
