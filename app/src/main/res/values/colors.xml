<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="material_grey_500">#9E9E9E</color>
    <color name="material_grey_700">#616161</color>
    <color name="material_grey_900">#212121</color>

    <color name="primary_dark">@color/material_grey_900</color>
    <color name="primary_light">#fffbff</color>
    <color name="material_orange_700">#f57c00</color>
    <color name="material_green_700">#388e3c</color>
    <color name="material_red_700">#D32F2F</color>

    <color name="text_primary">#f7f7f7</color>
    <color name="text_second">#bdbebd</color>
    <color name="text_dark">#b5babd</color>
    <color name="black_overlay">#66000000</color>

    <color name="setting_background_color">#F0F0F0</color>
    <!-- The app's accent: Material's blue primary, the family of the background gradient.
         Constant across day and night: it sits under white text on buttons and dialogs. -->
    <color name="brand_primary">#415F91</color>
    <color name="onb_audio_card">#EEF5F3</color>
    <color name="onb_audio_option">#F6FAF9</color>
    <color name="onb_audio_option_selected">#FFFFFF</color>
    <color name="onb_audio_chip_bg">#E1EDE3</color>
    <color name="onb_audio_chip_text">#1B5E20</color>
    <color name="divider_color">#1F000000</color>
    <color name="adaptive_text_color">#DE000000</color>

    <color name="extreme_dark_background">#000000</color>
    <!-- The flat page color, day and night (values-night): that of wDSP Pro's Classic look. The home screen's window
         draws the picture behind it, see drawable/bg. -->
    <color name="app_background">#EAEAE9</color>
    <color name="splash_background">@color/app_background</color>
    <!-- "OPEN" on the splash: white at night, dark on the pale day background. -->
    <color name="splash_text_white">#212121</color>
    <color name="splash_text_revived">#214876</color>

    <!-- Custom Menu Colors -->
    <color name="color_projection_blue">#3198ef</color>
    <color name="color_usb_orange">#f57c00</color>
    <color name="color_wifi_purple">#8e44ad</color>
    <color name="color_settings_darkblue">#2c3e50</color>

    <!-- Home Button Icon Tints -->

    <!-- Failure banner on the main screen. Amber rather than red: these are conditions the user
         can usually fix, and a red screen on a car dashboard reads as a fault in the car. -->
    <color name="warning_banner_tint">#26F57C00</color>
    <color name="warning_banner_stroke">#66F57C00</color>
    <color name="warning_banner_icon">#F57C00</color>


    <!-- Material 3 color roles: the blue scheme Material Theme Builder generates (source #415F91).
         Selections use the secondary container, a muted slate blue, as Material does. The
         settings screen reads them through the settings* theme attributes (see attrs.xml), so
         extreme dark can swap them. -->
    <color name="md_surface">@color/app_background</color>
    <color name="md_surface_container">#F8F8F7</color>
    <color name="md_surface_container_highest">#DEDEDD</color>
    <color name="md_surface_container_high">#F2F2F1</color>
    <color name="md_on_surface">#191C20</color>
    <color name="md_on_surface_variant">#44474E</color>
    <color name="md_outline">#74777F</color>
    <color name="md_outline_variant">#C8C8C6</color>
    <color name="md_primary">#415F91</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_secondary_container">#DAE2F9</color>
    <color name="md_on_secondary_container">#131C2B</color>

    <!-- Extreme dark: every surface is black and only faint outlines separate groups. -->
    <color name="md_extreme_container_highest">#0D0D0D</color>
    <color name="md_extreme_on_surface">#B8B8B8</color>
    <color name="md_extreme_on_surface_variant">#7A7A7A</color>
    <color name="md_extreme_outline">#4D4D4D</color>
    <color name="md_extreme_outline_variant">#1F1F1F</color>
    <color name="md_extreme_primary">#7C95BA</color>
    <color name="md_extreme_secondary_container">#14171C</color>

    <!-- Home screen: flat panels, so the zones read apart without elevation on old units. Material's tonal cards on
         app_background: panels a step from it and tiles a step further, neutral in both looks.
         Day colors here, dark ones in values-night. Extreme dark is a theme rather than a
         resource qualifier, so its colors are the home_extreme_* set and HomeUiHelper picks them. -->
    <color name="home_ripple">#1F000000</color>
    <color name="home_panel">#F6F6F5</color>
    <color name="home_panel_stroke">#00000000</color>
    <color name="home_tile">#FFFFFF</color>
    <color name="home_tile_pressed">#E3E3E2</color>
    <color name="home_tile_stroke">#14000000</color>
    <color name="home_slot_stroke">#BDBDBB</color>
    <color name="home_text">#1C1C1E</color>
    <color name="home_text_muted">#5F5F63</color>
    <color name="home_apps_tile">#FFFFFF</color>
    <color name="home_apps_tile_pressed">#E3E3E2</color>
    <color name="home_apps_icon">#028889</color>
    <color name="home_usb">#B9530F</color>
    <color name="home_wifi">#009688</color>
    <color name="home_self">#1F5FAE</color>
    <color name="home_monochrome">#5F5F63</color>
    <color name="home_countdown_ring">#661C1C1E</color>

    <color name="home_extreme_panel">#000000</color>
    <color name="home_extreme_panel_stroke">#161616</color>
    <color name="home_extreme_tile">#0A0A0A</color>
